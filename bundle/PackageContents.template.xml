<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage SchemaVersion="1.0"
                    ProductType="Application"
                    Name="Retrace"
                    Description="Records ribbon clicks, commands, prompts and dialogs during a manual test, replays them, and documents the AutoCAD UI from source."
                    AppVersion="{Version}"
                    Author="Retrace contributors"
                    ProductCode="{B95EF013-0CDE-4A6F-9A2D-B1566DD338E5}"
                    UpgradeCode="{2F9AC8ED-9790-4913-AE3B-76BDDEB2DF8F}">
  <CompanyDetails Name="Retrace contributors" />
  <!-- AutoCAD 2024 (.NET Framework 4.8): the net48 build and its dependencies -->
  <Components Description="Retrace for AutoCAD 2024">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="{Series2024}" SeriesMax="{Series2024}" />
    <ComponentEntry AppName="Retrace"
                    Version="{Version}"
                    ModuleName="./Contents/2024/Retrace.dll"
                    AppDescription="Retrace recorder, replayer and documentation builder"
                    LoadOnAutoCADStartup="True"
                    LoadOnCommandInvocation="False" />
  </Components>
  <!-- AutoCAD 2026 (.NET 8): the net8.0-windows build, one dll. Each build has its own Contents\<year> folder; nothing version-specific is loose in Contents. -->
  <Components Description="Retrace for AutoCAD 2026">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="{Series2026}" SeriesMax="{Series2026}" />
    <ComponentEntry AppName="Retrace"
                    Version="{Version}"
                    ModuleName="./Contents/2026/Retrace.dll"
                    AppDescription="Retrace recorder, replayer and documentation builder"
                    LoadOnAutoCADStartup="True"
                    LoadOnCommandInvocation="False" />
  </Components>
</ApplicationPackage>
