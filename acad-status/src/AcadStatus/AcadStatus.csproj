<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- lets macOS and Linux build the Windows target -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms would add System.Drawing / System.Windows.Forms usings to every file (Timer, Color, Application would clash with Core/ names
         and with the files the tests compile without WinForms): every file spells out its usings -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AcadStatus</AssemblyName>
    <RootNamespace>AcadStatus</RootNamespace>
    <Version>0.1.0</Version>
    <!-- AcadStatus.dll is the only file of the plugin: it uses nothing but the framework and AutoCAD's own assemblies -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- the AutoCAD release the bundle loads in (PackageContents.xml SeriesMin/SeriesMax); keep in step with the AutoCAD.NET package
         below (the build passes it to trust-acadstatus.ps1 as -Series) -->
    <AutoCADSeries>R25.1</AutoCADSeries>
    <!-- Visual Studio skips MSBuild when the dll is up to date, and with it the bundle and the install (bundle/AcadStatus.Bundle.targets) -->
    <DisableFastUpToDateCheck Condition="'$(OS)' == 'Windows_NT'">true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemGroup>
    <!-- 25.1.0 is the package for AutoCAD 2026 (25.1.1 is a net10 build). ExcludeAssets="runtime": no Autodesk dll is copied anywhere. -->
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- after every build: lay out bin/<Configuration>/AcadStatus.bundle; on Windows also install and trust it (see the file) -->
  <Import Project="..\..\bundle\AcadStatus.Bundle.targets" />
</Project>
