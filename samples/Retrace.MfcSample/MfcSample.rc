IDD_SAMPLE_VIEW DIALOGEX 0, 0, 360, 280
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    SAMPLE_CONTROLS
    DEFPUSHBUTTON   "Add",IDC_ADD,303,258,50,14
END

IDD_SAMPLE_DIALOG DIALOGEX 0, 0, 360, 294
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MFC dialog sample"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_TOOLBAR_HOLDER,7,4,346,16
    SAMPLE_CONTROLS
    DEFPUSHBUTTON   "OK",IDOK,246,274,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,303,274,50,14
END

STRINGTABLE
BEGIN
    ID_PV_ICONS   "Show the products as icons\nIcon view"
    ID_PV_LIST    "Show the products as a list\nList view"
    ID_PV_DETAILS "Show the products with details\nDetail view"
END
