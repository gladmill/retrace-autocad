<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only, so feeds, disabled sources or source mappings configured elsewhere on a machine (a company feed
     that needs a login, nuget.org unticked in Visual Studio) cannot break a build. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
